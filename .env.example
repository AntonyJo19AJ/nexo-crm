# Copia este archivo como .env antes de usar Docker Compose.
# Django no lee .env por sí solo: los valores por defecto bastan para desarrollo local.

# Clave secreta de Django (usa una cadena larga y aleatoria en producción).
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-segura

# Depuración (False en producción).
DJANGO_DEBUG=True

# Hosts permitidos, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes confiables para CSRF (solo si usas un dominio propio).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mi-dominio.com

# Ruta del archivo SQLite.
# SQLITE_PATH=db.sqlite3

# Puerto publicado por Docker Compose.
# APP_PORT=8000
